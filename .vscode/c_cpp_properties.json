{
    "configurations": [
        {
            "name": "PlatformIO",
            "includePath": [
                "${workspaceFolder}/include",
                "${workspaceFolder}/src",
                "${workspaceFolder}/lib",
                "${env:USERPROFILE}/.platformio/packages/framework-arduino-avr/cores/arduino",
                "${env:USERPROFILE}/.platformio/packages/framework-arduino-avr/variants/mega",
                "${env:USERPROFILE}/.platformio/packages/framework-arduino-avr/libraries/EEPROM/src",
                "${env:USERPROFILE}/.platformio/packages/framework-arduino-avr/libraries/HID/src",
                "${env:USERPROFILE}/.platformio/packages/framework-arduino-avr/libraries/SPI/src",
                "${env:USERPROFILE}/.platformio/packages/framework-arduino-avr/libraries/SoftwareSerial/src",
                "${env:USERPROFILE}/.platformio/packages/framework-arduino-avr/libraries/Wire/src",
                "",
                "${workspaceFolder}/src"
            ],
            "browse": {
                "limitSymbolsToIncludedHeaders": true,
                "path": [
                    "${workspaceFolder}/include",
                    "${workspaceFolder}/src",
                    "${workspaceFolder}/lib",
                    "${env:USERPROFILE}/.platformio/packages/framework-arduino-avr/cores/arduino",
                    "${env:USERPROFILE}/.platformio/packages/framework-arduino-avr/variants/mega",
                    "${env:USERPROFILE}/.platformio/packages/framework-arduino-avr/libraries/EEPROM/src",
                    "${env:USERPROFILE}/.platformio/packages/framework-arduino-avr/libraries/HID/src",
                    "${env:USERPROFILE}/.platformio/packages/framework-arduino-avr/libraries/SPI/src",
                    "${env:USERPROFILE}/.platformio/packages/framework-arduino-avr/libraries/SoftwareSerial/src",
                    "${env:USERPROFILE}/.platformio/packages/framework-arduino-avr/libraries/Wire/src",
                    ""
                ]
            },
            "defines": [
                "PLATFORMIO=60200",
                "ARDUINO_AVR_MEGA2560",
                "F_CPU=16000000L",
                "ARDUINO_ARCH_AVR",
                "ARDUINO=10808",
                "__AVR_ATmega2560__",
                ""
            ],
            "cStandard": "gnu11",
            "cppStandard": "gnu++11",
            "compilerPath": "${env:USERPROFILE}/.platformio/packages/toolchain-atmelavr/bin/avr-gcc.exe",
            "compilerArgs": [
                "-mmcu=atmega2560",
                ""
            ]
        }
    ],
    "version": 4
}